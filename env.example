API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# Firebase Realtime Database (welcome settings + music favourites)
FIREBASE_URL=
FIREBASE_SECRET=

# OPTIONAL - you can instead send /setstring <session> to the bot in DM (owner only).
# Session string of a SPARE Telegram user account (the "assistant" that joins voice chats)
STRING_SESSION=
MUSIC_DURATION_LIMIT=180
MUSIC_QUEUE_LIMIT=20

# Third-party music API (key from @MeowApiRobot)
MUSIC_API_URL=https://music.yukiapi.site
MUSIC_API_KEY=your_key_from_MeowApiRobot
MUSIC_API_TIMEOUT=300

# Logger chat (new group / removed group notices, broadcast logs). 0 = off
LOGGER_ID=0
# Image for logger messages (optional)
START_IMG=

# Extra owners: user IDs (comma separated) who can use owner commands like OWNER_ID
AUTH_USER=

# Start-screen button links (empty = button hidden)
SUPPORT_CHAT_URL=
SUPPORT_CHANNEL_URL=
OWNER_URL=

# Optional premium-emoji IDs for the start buttons (needs a Premium bot owner)
ICON_ADD=
ICON_HELP=
ICON_CLOSE=
