API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# Firebase Realtime Database (welcome settings + music favourites)
FIREBASE_URL=
FIREBASE_SECRET=

# OPTIONAL - you can instead send /setstring <session> to the bot in DM (owner only).
# Session string of a SPARE Telegram user account (the "assistant" that joins voice chats)
STRING_SESSION=
# Multi-assistants (optional): more spare accounts. Groups are shared between them.
STRING_SESSION2=
STRING_SESSION3=
MUSIC_DURATION_LIMIT=180
MUSIC_QUEUE_LIMIT=50

# Third-party music API (key from @MeowApiRobot)
MUSIC_API_URL=https://music.yukiapi.site
MUSIC_API_KEY=your_key_from_MeowApiRobot
MUSIC_API_TIMEOUT=300

# Logger chat (new group / removed group notices, broadcast logs). 0 = off
LOGGER_ID=0
# Image for logger messages (optional)
START_IMG=

# Extra owners: user IDs (comma separated) who can use owner commands like OWNER_ID
AUTH_USER=

# Start-screen button links (empty = button hidden)
SUPPORT_CHAT_URL=
SUPPORT_CHANNEL_URL=
OWNER_URL=

# Optional premium-emoji IDs for the start buttons (needs a Premium bot owner)
ICON_ADD=
ICON_HELP=
ICON_CLOSE=

# ---- Speed / quality (all optional, these are the defaults) ----
# Start playing straight from the API stream (1) or wait for a full download first (0)
MUSIC_DIRECT_STREAM=1
# Source quality in order of preference (kbps)
MUSIC_API_QUALITY=320,192,128
# Voice-chat audio profile: STUDIO (48 kHz stereo, best) | HIGH | MEDIUM | LOW
MUSIC_AUDIO_QUALITY=STUDIO
# Queued songs downloaded ahead of time
MUSIC_PREFETCH=2
# Auto queue: when fewer than MIN songs wait, add BATCH similar ones
MUSIC_AUTO_MIN=3
MUSIC_AUTO_BATCH=5
# Live radio: check stations at start-up (1/0) and which countries' popular stations to add
MUSIC_RADIO_VALIDATE=1
MUSIC_RADIO_COUNTRIES=IN,US,GB

# ---- Song cache in Firebase (needs FIREBASE_URL) ----
# Each song is downloaded from the API once, saved to Firebase and played from there afterwards.
MUSIC_CACHE=1
MUSIC_CACHE_MAX_MB=800
MUSIC_CACHE_MAX_SONG_MB=14
